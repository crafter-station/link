---
import Base from "../layouts/Base.astro"
import ArrowLink from "../components/ArrowLink.astro"
import Mark from "../components/Mark.astro"
import { links, avatarFor, displayHref, NETWORK } from "../lib/links"
import { iconForSocial } from "../lib/icons"

const { org, members } = links

const social = (label: string) => org.socials.find((entry) => entry.label === label)
const pick = (labels: string[]) =>
  labels.map(social).filter((entry): entry is NonNullable<typeof entry> => Boolean(entry))

// Grouped by what the visitor came to do. "Research" lives in `socials`
// upstream but is shown in the universe tiles instead.
const community = pick(["WhatsApp", "Discord", "Luma"])
const follow = pick(["LinkedIn", "GitHub", "X", "Instagram", "YouTube"])

const COMMUNITY_BLURB: Record<string, string> = {
  WhatsApp: "1.000+ builders en crafters.chat",
  Discord: "Conversa con los crafters",
  Luma: "Eventos y hackathons en hack0",
}

let n = 0
const next = () => ++n
---

<Base
  title="Crafter Station · todos los links"
  description="Todos los links de Crafter Station: la comunidad, lo que construimos y cada crafter."
>
  <section class="hero">
    <a class="wordmark" href={org.url} target="_blank" rel="noopener noreferrer" aria-label="Crafter Station">
      <Mark />
      <span>crafter<br />station</span>
    </a>
    <h1>Craft. Ship. <em>Repeat.</em></h1>
    <p>Una comunidad para convertir la curiosidad en proyectos, desde el Perú para LATAM.</p>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="rows">
      <ArrowLink href="https://crafters.chat" title="Únete a la comunidad" sub="WhatsApp · crafters.chat" icon="whatsapp" primary />
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2 class="label">Comunidad</h2>
      <span class="count">{community.length}</span>
    </div>
    <div class="rows">
      {
        community.map((entry) => (
          <ArrowLink
            href={entry.href}
            title={entry.label}
            sub={COMMUNITY_BLURB[entry.label] ?? displayHref(entry.href)}
            icon={iconForSocial(entry.label)}
            index={next()}
          />
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2 class="label">Universo Crafter</h2>
      <span class="count">{NETWORK.length}</span>
    </div>
    <div class="universe">
      {
        NETWORK.map((area) => (
          <a
            class="tile"
            href={area.url}
            target="_blank"
            rel="noopener noreferrer"
            style={`--tile-bg: ${area.bg}; --tile-ink: ${area.ink}`}
          >
            <b>{area.name}</b>
            <span>{area.tagline}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2 class="label">Lo que construimos</h2>
      <span class="count">{org.products.length}</span>
    </div>
    <div class="rows">
      {
        org.products.map((product) => (
          <ArrowLink
            href={product.url}
            title={product.title}
            sub={product.tagline ?? displayHref(product.url)}
            index={next()}
          />
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2 class="label">Los crafters</h2>
      <span class="count">{members.length}</span>
    </div>
    <div class="people">
      {
        members.map((member) => (
          <a class="person" href={`/${member.username}/`}>
            <img
              class="person-avatar"
              src={avatarFor(member)}
              alt=""
              width="44"
              height="44"
              decoding="async"
            />
            <span class="person-body">
              <span class="person-name">{member.name}</span>
              <span class="person-role">{member.role}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2 class="label">Síguenos</h2>
      <span class="count">{follow.length}</span>
    </div>
    <div class="rows">
      {
        follow.map((entry) => (
          <ArrowLink
            href={entry.href}
            title={entry.label}
            sub={displayHref(entry.href)}
            icon={iconForSocial(entry.label)}
            index={next()}
          />
        ))
      }
    </div>
  </section>
</Base>
